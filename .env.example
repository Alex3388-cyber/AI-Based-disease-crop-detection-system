# Copy this file to .env for local development. Replace every CHANGE_ME value.
NODE_ENV=development
LOG_LEVEL=info

# Browser-facing addresses
PUBLIC_ORIGIN=http://localhost:8080
FRONTEND_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=3000

# PostgreSQL (use a non-superuser application account outside local setup)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=crop_disease
DATABASE_USER=crop_api
DATABASE_PASSWORD=CHANGE_ME
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Django uses a separate content-management role in the container setup.
DJANGO_DATABASE_USER=crop_admin_app
DJANGO_DATABASE_PASSWORD=CHANGE_ME_DIFFERENT_VALUE

# Private inference service
AI_SERVICE_URL=http://localhost:5000
AI_SERVICE_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AI_TIMEOUT_MS=10000
AI_READINESS_TIMEOUT_MS=2000
AI_SERVICE_PORT=5000

# Upload and inference safety limits
MAX_UPLOAD_MB=8
MAX_IMAGE_BYTES=8388608
MIN_IMAGE_DIMENSION=32
MAX_IMAGE_DIMENSION=8192
MAX_IMAGE_WIDTH=8192
MAX_IMAGE_HEIGHT=8192
MAX_IMAGE_PIXELS=25000000
# Node applies this conservative operational floor in addition to model uncertainty.
MODEL_CONFIDENCE_THRESHOLD=0.70
# Leave blank to use the calibrated threshold exported with the model bundle.
AI_MODEL_CONFIDENCE_THRESHOLD=
MODEL_DIR=./ai-service/model
MAX_CONCURRENT_INFERENCES=2
MAX_CONCURRENT_PREDICTIONS=2
GENERAL_RATE_LIMIT_MAX=120
PREDICTION_RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
REQUEST_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY=false

# Django administration
DJANGO_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_ADMIN_PATH=admin
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false

# Docker-only database owner/migration account. It is never given to runtime apps.
POSTGRES_OWNER_USER=crop_owner
POSTGRES_OWNER_PASSWORD=CHANGE_ME_DIFFERENT_OWNER_VALUE
